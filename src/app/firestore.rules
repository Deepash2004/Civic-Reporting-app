rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read and write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Issues can be read by anyone (public civic reports)
    // but only created/updated by authenticated users
    match /issues/{issueId} {
      allow read: if true; // Public read access for transparency
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && (
        // User can update their own issues
        request.auth.uid == resource.data.userId ||
        // Or admin users (you can add admin check logic here)
        request.auth.token.admin == true
      );
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.userId;
    }
    
    // Notifications can be read and marked as read by the user they belong to
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
    }
    
    // Community data (leaderboards, stats) - read only for users
    match /community/{document=**} {
      allow read: if true;
      allow write: if false; // Only server/admin can write community data
    }
    
    // Analytics and usage data - read only for users  
    match /analytics/{document=**} {
      allow read: if request.auth != null;
      allow write: if false; // Only server can write analytics
    }
    
    // Admin collection - restricted access
    match /admin/{document=**} {
      allow read, write: if request.auth != null && 
        request.auth.token.admin == true;
    }
  }
}